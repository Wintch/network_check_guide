[Unit]
Description=Run the network watchdog every 3 days

[Timer]
# A real 3-day period: first run 15 minutes after your user systemd instance
# starts (login, or boot when lingering is enabled), then every 3 days after the
# previous run. A calendar expression like "*-*-1/3" would instead mean "days 1,
# 4, 7 ... of each month" and resets every month. The timer is restarted by a
# reboot/re-login, so it also runs once shortly after each of those.
OnStartupSec=15min
OnUnitActiveSec=3d
# Adds a random 0..30 min delay to each run so it doesn't always fire at the
# exact same moment.
RandomizedDelaySec=30min
# (Persistent=true is deliberately absent: systemd only honours it for OnCalendar=
# timers. A run missed while the machine was off is simply caught up by the
# OnStartupSec run after the next login/boot.)

# NOTE: this is a user timer, so it only fires while your user systemd instance
# is running (an open session). To keep it running without a login session:
#   loginctl enable-linger "$USER"

[Install]
WantedBy=timers.target
