[Unit]
Description=Run the network watchdog every few days

[Timer]
# Every 3 days, at a low-usage hour, +/- up to 30min so it doesn't always
# land at the exact same moment. Persistent=true means if the machine was
# off/asleep when it should have fired, it runs shortly after boot instead
# of silently skipping that cycle.
OnCalendar=*-*-1/3 04:00:00
RandomizedDelaySec=1800
Persistent=true

[Install]
WantedBy=timers.target
